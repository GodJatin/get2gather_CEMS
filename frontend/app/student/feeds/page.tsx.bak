'use client';

import { useState, useEffect, useRef, Fragment } from 'react';
import api from '@/lib/api';
import { motion, AnimatePresence } from 'framer-motion';
import { useRouter } from 'next/navigation';
import Link from 'next/link';
import { Dialog, Transition } from '@headlessui/react';

interface User {
    id: number;
    name: string;
    role: string;
}

interface Comment {
    id: number;
    user_name: string;
    content: string;
    created_at: string;
}

interface Post {
    id: number;
    user_id: number;
    user_name: string;
    user_role: string;
    content: string;
    media_urls: string[];
    media_type: string;
    event_title: string;
    likes_count: number;
    comments_count: number;
    is_liked: boolean;
    current_user_reaction: string | null;
    is_following: boolean;
    comments: Comment[];
    created_at: string;
    location?: string;
    feeling?: string;
    tagged_users?: number[];
}

const REACTIONS = [
    { type: 'like', icon: '❤️', label: 'Love' },
    { type: 'fire', icon: '🔥', label: 'Fire' },
    { type: 'haha', icon: '😂', label: 'Haha' },
    { type: 'wow', icon: '😮', label: 'Wow' },
    { type: 'sad', icon: '😢', label: 'Sad' },
    { type: 'party', icon: '🎉', label: 'Party' },
];

export default function FeedPage() {
    const [posts, setPosts] = useState<Post[]>([]);
    const [loading, setLoading] = useState(true);
    const [isCreateModalOpen, setIsCreateModalOpen] = useState(false);
    const [newPostContent, setNewPostContent] = useState('');
    const [selectedImages, setSelectedImages] = useState<string[]>([]);
    const [uploading, setUploading] = useState(false);

    const [activeReactionId, setActiveReactionId] = useState<number | null>(null);
    const [activeCommentId, setActiveCommentId] = useState<number | null>(null);
    const [commentInput, setCommentInput] = useState('');
    
    // Explore / Search State
    const [showExplore, setShowExplore] = useState(false);
    const [searchQuery, setSearchQuery] = useState('');
    const [searchResults, setSearchResults] = useState<any[]>([]);
    const [searching, setSearching] = useState(false);

    // Smart Tagging State
    const [suggestions, setSuggestions] = useState<{ id: number; label: string; type: 'user' | 'event' }[]>([]);
    const [showSuggestions, setShowSuggestions] = useState(false);
    const [suggestionQuery, setSuggestionQuery] = useState('');
    const [cursorPos, setCursorPos] = useState(0);
    const [triggerType, setTriggerType] = useState<'@' | '#'>('@');
    
    // Data for suggestions
    const [myEvents, setMyEvents] = useState<{ id: number; title: string }[]>([]);
    
    const textareaRef = useRef<HTMLTextAreaElement>(null);
    const router = useRouter();

    const fetchPosts = async () => {
        try {
            const res = await api.get('/feed/');
            setPosts(Array.isArray(res.data) ? res.data : []);
        } catch (error) {
            console.error(error);
            setPosts([]);
        } finally {
            setLoading(false);
        }
    };

    useEffect(() => {
        fetchPosts();
        
        // Fetch eligible events for tags (My Bookings)
        api.get('/bookings/my').then(res => {
            const events = res.data.map((b: any) => ({ id: b.event_id, title: b.event_title })).filter((e: any) => e.title);
            // Deduplicate
            const unique = events.filter((e: any, i: any, a: any) => a.findIndex((t: any) => t.id === e.id) === i);
            setMyEvents(unique);
        }).catch(err => console.error("Failed to load events for tagging", err));
    }, []);

    // Handle Input Change for Smart Tagging
    const handleInputChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {
        const val = e.target.value;
        setNewPostContent(val);
        setCursorPos(e.target.selectionStart);

        // Check for trigger characters before cursor
        const textBeforeCursor = val.slice(0, e.target.selectionStart);
        const lastAt = textBeforeCursor.lastIndexOf('@');
        const lastHash = textBeforeCursor.lastIndexOf('#');
        
        const lastTrigger = Math.max(lastAt, lastHash);
        
        if (lastTrigger !== -1) {
            const triggerChar = textBeforeCursor[lastTrigger];
            const query = textBeforeCursor.slice(lastTrigger + 1);
            
            // Only trigger if no space inside query (simple tag logic)
            if (!query.includes(' ')) {
                setTriggerType(triggerChar as '@' | '#');
                setSuggestionQuery(query.toLowerCase());
                setShowSuggestions(true);
                return;
            }
        }
        setShowSuggestions(false);
    };

    // Filter Suggestions
    useEffect(() => {
        if (!showSuggestions) return;

        if (triggerType === '#') {
            const matches = myEvents
                .filter(e => e.title.toLowerCase().includes(suggestionQuery))
                .map(e => ({ id: e.id, label: e.title, type: 'event' as 'event' }));
            setSuggestions(matches);
        } else {
            // Mock Users for demo (In real app, fetch from /users/search?q=...)
            const mockUsers = [
                { id: 1, label: 'Amit Patel', type: 'user' as 'user' },
                { id: 2, label: 'Priya Sharma', type: 'user' as 'user' },
                { id: 3, label: 'Rahul Singh', type: 'user' as 'user' },
                { id: 4, label: 'Sneha Gupta', type: 'user' as 'user' },
            ];
            setSuggestions(mockUsers.filter(u => u.label.toLowerCase().includes(suggestionQuery)));
        }
    }, [showSuggestions, suggestionQuery, triggerType, myEvents]);

    const insertTag = (item: { id: number; label: string; type: string }) => {
        const textBeforeCursor = newPostContent.slice(0, cursorPos);
        const lastTrigger = Math.max(textBeforeCursor.lastIndexOf('@'), textBeforeCursor.lastIndexOf('#'));
        
        if (lastTrigger === -1) return;

        const prefix = newPostContent.slice(0, lastTrigger);
        const suffix = newPostContent.slice(cursorPos);
        
        const newText = `${prefix}${triggerType}${item.label} ${suffix}`;
        setNewPostContent(newText);
        setShowSuggestions(false);
        textareaRef.current?.focus();
    };

    const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
        if (e.target.files && e.target.files.length > 0) {
            if (selectedImages.length + e.target.files.length > 5) {
                alert('Max 5 images allowed');
                return;
            }
            
            const newImages: string[] = [];
            let error = false;

            Array.from(e.target.files).forEach(file => {
                if (file.size > 5 * 1024 * 1024) { // 5MB limit
                    alert(`Image ${file.name} is too large. Max 5MB.`);
                    error = true;
                    return;
                }
                const reader = new FileReader();
                reader.onloadend = () => {
                    if (reader.result) {
                        setSelectedImages(prev => [...prev, reader.result as string]);
                    }
                };
                reader.readAsDataURL(file);
            });
            
            if (error) return; 
        }
    };

    const handleCreatePost = async () => {
        if (!newPostContent && selectedImages.length === 0) return;
        setUploading(true);
        try {
            const taggedEventIds = myEvents
                .filter(e => newPostContent.includes(`#${e.title}`))
                .map(e => e.id);

            await api.post('/feed/', {
                content: newPostContent,
                media_urls: [], // Temporarily disabled to prevent Base64 DB crashes
                media_type: 'text',
                tagged_events: taggedEventIds.length > 0 ? taggedEventIds : undefined,
            });
            setIsCreateModalOpen(false);
            setNewPostContent('');
            setSelectedImages([]);
            fetchPosts();
        } catch (error) {
            alert('Failed to post');
        } finally {
            setUploading(false);
        }
    };

    const handleFollow = async (userId: number) => {
        try {
            await api.post(`/social/follow/${userId}`);
            // Optimistic update for posts
            setPosts(prev => prev.map(p => 
                p.user_id === userId ? { ...p, is_following: !p.is_following } : p
            ));
            // Optimistic update for search results
            setSearchResults(prev => prev.map(u => 
                u.user_id === userId ? { ...u, is_following: !u.is_following } : u
            ));
        } catch (error) {
            console.error('Follow failed', error);
        }
    };

    const handleReaction = async (postId: number, type: string) => {
        // Optimistic update
        setPosts(prev => prev.map(p => {
            if (p.id === postId) {
                const wasLiked = p.is_liked;
                const oldReaction = p.current_user_reaction;
                let newCount = p.likes_count;
                
                if (wasLiked && oldReaction === type) {
                    newCount--;
                    return { ...p, is_liked: false, current_user_reaction: null, likes_count: newCount };
                } else if (wasLiked) {
                    return { ...p, is_liked: true, current_user_reaction: type };
                } else {
                    newCount++;
                    return { ...p, is_liked: true, current_user_reaction: type, likes_count: newCount };
                }
            }
            return p;
        }));
        setActiveReactionId(null);

        try {
            await api.post(`/feed/${postId}/like`, { reaction_type: type });
        } catch (error) {
            console.error('Reaction failed');
            fetchPosts();
        }
    };

    const handleComment = async (postId: number) => {
        if (!commentInput.trim()) return;
        try {
            const res = await api.post(`/feed/${postId}/comment`, { content: commentInput });
            setPosts(prev => prev.map(p => {
                if (p.id === postId) {
                    return { ...p, comments: [...p.comments, res.data], comments_count: p.comments_count + 1 };
                }
                return p;
            }));
            setCommentInput('');
        } catch (e) {
            console.error(e);
        }
    };

    const handleSearch = async (query: string) => {
        setSearchQuery(query);
        if (query.length > 2) {
            setSearching(true);
            try {
                const res = await api.get(`/social/search?q=${query}`);
                setSearchResults(res.data);
            } catch (e) {
                console.error(e);
            } finally {
                setSearching(false);
            }
        } else {
            setSearchResults([]);
        }
    };

    return (
        <div className="max-w-2xl mx-auto pb-20 pt-4 px-4">
            {/* Header */}
            <div className="flex items-center justify-between mb-6">
                <h1 className="text-3xl font-bold bg-gradient-to-r from-white to-neutral-400 bg-clip-text text-transparent">Social Feed</h1>
                <div className="flex gap-2">
                    <button 
                        onClick={() => setShowExplore(!showExplore)}
                        className="w-10 h-10 rounded-full bg-neutral-800 flex items-center justify-center font-bold text-xl hover:bg-neutral-700 transition-colors"
                    >
                        {showExplore ? '🏠' : '🔍'}
                    </button>
                    <button 
                        onClick={() => setIsCreateModalOpen(true)}
                        className="w-10 h-10 rounded-full bg-white text-black flex items-center justify-center font-bold text-xl hover:scale-105 transition-transform"
                    >
                        +
                    </button>
                </div>
            </div>

            {/* Explore Section */}
            {showExplore ? (
                <div className="mb-8">
                    <input 
                        type="text"
                        placeholder="Search for friends to follow..."
                        className="w-full bg-neutral-900 border border-white/10 rounded-xl px-4 py-3 mb-4 focus:border-primary focus:outline-none"
                        value={searchQuery}
                        onChange={(e) => handleSearch(e.target.value)}
                    />
                    <div className="space-y-3">
                        {searchResults.map((user) => (
                            <div key={user.id} className="flex items-center justify-between p-4 bg-neutral-900/50 rounded-xl border border-white/5">
                                <Link href={`/student/profile/${user.id}`} className="flex items-center gap-3">
                                    <div className="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center text-white font-bold">
                                        {(user.name && user.name[0]) || '?'}
                                    </div>
                                    <div>
                                        <div className="font-bold">{user.name || 'Unknown'}</div>
                                        {user.department && <div className="text-xs text-neutral-500">{user.department}</div>}
                                    </div>
                                </Link>
                                <button 
                                    onClick={() => handleFollow(user.user_id)}
                                    className={`px-4 py-1.5 rounded-full text-xs font-bold transition-colors ${
                                        user.is_following 
                                            ? 'bg-neutral-800 text-neutral-400 border border-white/10' 
                                            : 'bg-primary text-black hover:bg-primary/90'
                                    }`}
                                >
                                    {user.is_following ? 'Following' : 'Follow'}
                                </button>
                            </div>
                        ))}
                    </div>
                </div>
            ) : (
                /* Posts Feed */
                <div className="space-y-8">
                    {posts.map(post => (
                        <motion.div 
                            initial={{ opacity: 0, y: 20 }}
                            whileInView={{ opacity: 1, y: 0 }}
                            viewport={{ once: true }}
                            key={post.id} 
                            className="bg-neutral-900/50 border border-white/5 rounded-3xl overflow-hidden"
                        >
                            {/* Post Header */}
                            <div className="p-4 flex items-center gap-3">
                                <Link href={`/student/profile/${post.user_id}`}>
                                    <div className="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold cursor-pointer">
                                        {(post.user_name && post.user_name[0]) || '?'}
                                    </div>
                                </Link>
                                <div className="flex-1">
                                    <Link href={`/student/profile/${post.user_id}`} className="font-bold text-sm hover:underline">
                                        {post.user_name || 'Unknown User'}
                                    </Link>
                                    <div className="flex items-center gap-2 text-xs text-neutral-500">
                                        <span>{new Date(post.created_at).toLocaleDateString()}</span>
                                        {post.location && <span>• {post.location}</span>}
                                        {post.feeling && <span>• is feeling {post.feeling}</span>}
                                    </div>
                                </div>
                                {!post.is_following && (
                                    <button 
                                        onClick={() => handleFollow(post.user_id)}
                                        className="text-xs font-bold text-blue-400 hover:text-blue-300"
                                    >
                                        Follow
                                    </button>
                                )}
                                {post.event_title && (
                                    <span className="text-xs px-2 py-1 rounded-full bg-[#00F0FF]/10 text-[#00F0FF] border border-[#00F0FF]/20">
                                        at {post.event_title}
                                    </span>
                                )}
                            </div>

                            {/* Media Carousel */}
                            {post.media_urls && post.media_urls.length > 0 && (
                                <div className="relative aspect-square bg-neutral-900 overflow-hidden group">
                                    <div className="flex overflow-x-auto snap-x snap-mandatory scrollbar-hide h-full">
                                        {post.media_urls.map((url, i) => (
                                            <img key={i} src={url} className="w-full h-full object-cover flex-shrink-0 snap-center" />
                                        ))}
                                    </div>
                                    {post.media_urls.length > 1 && (
                                        <div className="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-1.5 p-1 bg-black/40 backdrop-blur-sm rounded-full">
                                            {post.media_urls.map((_, i) => (
                                                <div key={i} className={`w-1.5 h-1.5 rounded-full ${i === 0 ? 'bg-white' : 'bg-white/30'}`} />
                                            ))}
                                        </div>
                                    )}
                                </div>
                            )}

                            {/* Actions */}
                            <div className="p-4">
                                <div className="flex items-center gap-4 mb-4 relative">
                                    {/* Like / Reaction Button */}
                                    <div className="relative">
                                        <button 
                                            onClick={() => handleReaction(post.id, 'like')}
                                            onMouseEnter={() => setActiveReactionId(post.id)}
                                            className="text-2xl hover:scale-110 transition-transform"
                                        >
                                            {post.is_liked ? 
                                                (REACTIONS.find(r => r.type === post.current_user_reaction)?.icon || '❤️') : 
                                                '🤍'
                                            }
                                        </button>
                                        
                                        {/* Hover Reaction Menu */}
                                        <AnimatePresence>
                                            {activeReactionId === post.id && (
                                                <motion.div 
                                                    initial={{ opacity: 0, scale: 0.8, y: 10 }}
                                                    animate={{ opacity: 1, scale: 1, y: -50 }}
                                                    exit={{ opacity: 0, scale: 0.8, y: 10 }}
                                                    onMouseLeave={() => setActiveReactionId(null)}
                                                    className="absolute left-0 bottom-full flex items-center gap-1 bg-white/10 backdrop-blur-md p-1 rounded-full border border-white/10 shadow-xl z-10"
                                                >
                                                    {REACTIONS.map(reaction => (
                                                        <button
                                                            key={reaction.type}
                                                            onClick={(e) => {
                                                                e.stopPropagation();
                                                                handleReaction(post.id, reaction.type);
                                                            }}
                                                            className="p-2 hover:bg-white/20 rounded-full hover:scale-125 transition-all text-xl"
                                                            title={reaction.label}
                                                        >
                                                            {reaction.icon}
                                                        </button>
                                                    ))}
                                                </motion.div>
                                            )}
                                        </AnimatePresence>
                                    </div>

                                    <button 
                                        onClick={() => setActiveCommentId(activeCommentId === post.id ? null : post.id)}
                                        className="text-2xl hover:scale-110 transition-transform"
                                    >
                                        💬
                                    </button>
                                    <button className="text-2xl hover:scale-110 transition-transform">↗️</button>
                                </div>

                                {/* Likes Count */}
                                <div className="font-bold text-sm mb-2">
                                    {post.likes_count > 0 ? `${post.likes_count} likes` : 'Be the first to like this'}
                                </div>

                                {/* Caption */}
                                <div className="text-sm text-neutral-300 mb-2">
                                    <span className="font-bold text-white mr-2">{post.user_name || 'User'}</span>
                                    {post.content}
                                </div>

                                {/* Comments Preview */}
                                {post.comments_count > 0 && activeCommentId !== post.id && (
                                    <button 
                                        onClick={() => setActiveCommentId(post.id)}
                                        className="text-xs text-neutral-500 mb-2"
                                    >
                                        View all {post.comments_count} comments
                                    </button>
                                )}

                                {/* Comments Section */}
                                <AnimatePresence>
                                    {activeCommentId === post.id && (
                                        <motion.div 
                                            initial={{ height: 0, opacity: 0 }}
                                            animate={{ height: 'auto', opacity: 1 }}
                                            exit={{ height: 0, opacity: 0 }}
                                            className="overflow-hidden"
                                        >
                                            <div className="space-y-2 mb-3 pl-2 border-l-2 border-white/10">
                                                {post.comments.map(comment => (
                                                    <div key={comment.id} className="text-xs">
                                                        <span className="font-bold mr-2">{comment.user_name}</span>
                                                        <span className="text-neutral-400">{comment.content}</span>
                                                    </div>
                                                ))}
                                            </div>
                                            <div className="flex gap-2">
                                                <input 
                                                    type="text" 
                                                    className="flex-1 bg-transparent border-b border-white/20 focus:border-white text-sm py-1 focus:outline-none"
                                                    placeholder="Add a comment..."
                                                    value={commentInput}
                                                    onChange={(e) => setCommentInput(e.target.value)}
                                                    onKeyDown={(e) => e.key === 'Enter' && handleComment(post.id)}
                                                />
                                                <button 
                                                    onClick={() => handleComment(post.id)}
                                                    disabled={!commentInput.trim()}
                                                    className="text-primary text-xs font-bold disabled:opacity-50"
                                                >
                                                    Post
                                                </button>
                                            </div>
                                        </motion.div>
                                    )}
                                </AnimatePresence>
                            </div>
                        </motion.div>
                    ))}
                </div>
            )}

            {/* Create Post Modal */}
            <AnimatePresence>
                {isCreateModalOpen && (
                    <motion.div 
                        initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}
                        className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4"
                    >
                         <motion.div 
                            initial={{ scale: 0.9, y: 20 }} animate={{ scale: 1, y: 0 }} exit={{ scale: 0.9, y: 20 }}
                            className="bg-neutral-900 border border-white/10 rounded-3xl w-full max-w-lg overflow-hidden"
                        >
                            <div className="p-6">
                                <h2 className="text-xl font-bold mb-4">Create New Post</h2>
                                <div className="relative">
                                    <textarea 
                                        ref={textareaRef}
                                        className="w-full bg-neutral-800 rounded-xl p-4 min-h-[120px] focus:outline-none focus:border-primary border border-transparent resize-none"
                                        placeholder="What's happening? @mention friends, #tag events..."
                                        value={newPostContent}
                                        onChange={handleInputChange}
                                        onClick={() => setShowSuggestions(false)}
                                    />
                                    {showSuggestions && suggestions.length > 0 && (
                                        <div className="absolute left-4 bottom-4 bg-neutral-800 border border-white/10 rounded-xl shadow-2xl max-h-40 overflow-y-auto z-50 w-64 translate-y-full">
                                            {suggestions.map((item, i) => (
                                                <button
                                                    key={i}
                                                    onClick={() => insertTag(item)}
                                                    className="w-full text-left px-4 py-2 hover:bg-white/10 flex items-center gap-2 transition-colors"
                                                >
                                                    <span className={item.type === 'event' ? 'text-primary' : 'text-secondary'}>
                                                        {item.type === 'event' ? '#' : '@'}
                                                    </span>
                                                    <span className="truncate text-sm">{item.label}</span>
                                                </button>
                                            ))}
                                        </div>
                                    )}
                                </div>
                                
                                {selectedImages.length > 0 && (
                                    <div className="flex gap-2 mt-4 overflow-x-auto pb-2">
                                        {selectedImages.map((img, i) => (
                                            <div key={i} className="relative w-20 h-20 rounded-lg overflow-hidden flex-shrink-0 group">
                                                <img src={img} className="w-full h-full object-cover" />
                                                <button 
                                                    onClick={() => setSelectedImages(prev => prev.filter((_, idx) => idx !== i))}
                                                    className="absolute top-1 right-1 bg-black/50 rounded-full w-5 h-5 flex items-center justify-center text-xs text-white opacity-0 group-hover:opacity-100 transition-opacity"
                                                >
                                                    ✕
                                                </button>
                                            </div>
                                        ))}
                                    </div>
                                )}

                                <div className="flex items-center justify-between mt-6">
                                    <label className="flex items-center gap-2 text-primary cursor-pointer hover:bg-white/5 px-3 py-2 rounded-lg transition-colors">
                                        <span>📷</span>
                                        <span className="text-sm font-medium">Add Photos</span>
                                        <input type="file" multiple accept="image/*" className="hidden" onChange={handleImageUpload} />
                                    </label>
                                    <div className="flex gap-2">
                                        <button 
                                            onClick={() => setIsCreateModalOpen(false)}
                                            className="px-4 py-2 text-neutral-400 hover:text-white transition-colors"
                                        >
                                            Cancel
                                        </button>
                                        <button 
                                            onClick={handleCreatePost}
                                            disabled={uploading}
                                            className="px-6 py-2 bg-gradient-to-r from-[#00F0FF] to-[#00FF94] text-black font-bold rounded-xl hover:opacity-90 transition-opacity disabled:opacity-50"
                                        >
                                            {uploading ? 'Posting...' : 'Post'}
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </motion.div>
                    </motion.div>
                )}
            </AnimatePresence>
        </div>
    );
}
