from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.orm import Session
from sqlalchemy.future import select
from sqlalchemy import desc, func
from database import get_db
from models import User, FeedPost, FeedLike, FeedComment, Student, Organizer, UserRole, Event
import schemas
# from schemas import FeedPostCreate, FeedPostResponse, FeedCommentCreate, FeedCommentResponse
from .auth import get_current_user
from datetime import datetime
from pydantic import BaseModel

router = APIRouter(prefix="/feed", tags=["Feed"])

@router.post("/", response_model=schemas.FeedPostResponse)
async def create_post(
    post_data: schemas.FeedPostCreate, 
    current_user: User = Depends(get_current_user), 
    db: Session = Depends(get_db)
):
    # DEBUG LOGGING TO FILE
    with open("feed_debug.log", "a") as f:
        f.write(f"\\n[{datetime.utcnow()}] create_post called by {current_user.id}\\n")
        f.write(f"Payload: {post_data.dict()}\\n")

    try:
        new_post = FeedPost(
            user_id=current_user.id,
            content=post_data.content,
            media_urls=post_data.media_urls,
            media_type=post_data.media_type,
            event_id=post_data.event_id,
            location=post_data.location,
            feeling=post_data.feeling,
            tagged_users=post_data.tagged_users, # JSON list
            tagged_events=post_data.tagged_events, # JSON list
            created_at=datetime.utcnow().isoformat()
        )
        db.add(new_post)
        db.commit()
        db.refresh(new_post)
        
        with open("feed_debug.log", "a") as f:
            f.write(f"[{datetime.utcnow()}] Post created successfully: {new_post.id}\\n")

        return await get_post_response(new_post, current_user, db)
    except Exception as e:
        with open("feed_debug.log", "a") as f:
            f.write(f"[{datetime.utcnow()}] create_post ERROR: {str(e)}\\n")
            import traceback
            f.write(traceback.format_exc() + "\\n")
            
        raise HTTPException(status_code=500, detail=str(e))

@router.get("/")
# response_model removed to debug serialization issues
async def get_feed(
    skip: int = 0, 
    limit: int = 5, # DEBUG: Force small limit
    following_only: bool = False,
    current_user: User = Depends(get_current_user), 
    db: Session = Depends(get_db)
):
    try:
        # Simplified query
        query = select(FeedPost).order_by(desc(FeedPost.created_at)).offset(skip).limit(limit)
        result = db.execute(query)
        posts = result.scalars().all()
        
        response_posts = []
        for post in posts:
            try:
                # Manually construct minimal safe dict to verify data flow
                # If this works, we add fields back one by one
                post_data = {
                    "id": post.id,
                    "content": post.content,
                    "user_id": post.user_id,
                    "media_urls": post.media_urls if post.media_urls else [],
                    "likes_count": 0, # Placeholder
                    "comments_count": 0, # Placeholder
                    "user_name": "Debug User", # Placeholder
                    "is_liked": False,
                    "is_following": False,
                    "created_at": post.created_at
                }
                # Try to get real enhanced data if possible, but fallback to above if it fails
                # Let's try to use the real helper BUT wrap it safely
                try:
                    full_data = await get_post_response(post, current_user, db)
                    response_posts.append(full_data)
                except Exception as e_deep:
                    print(f"Deep Error on Post {post.id}: {e_deep}")
                    response_posts.append(post_data) # Fallback to minimal

            except Exception as e_inner:
                print(f"Skipping Post {post.id} due to: {e_inner}")
                continue
            
        return response_posts
    except Exception as e:
        print(f"Outer Feed Error: {e}")
        return []
    except Exception as e:
        print(f"ERROR: Failed to fetch feed: {str(e)}")
        import traceback
        traceback.print_exc()
        return []

class ReactionRequest(BaseModel):
    reaction_type: str = "like"

@router.post("/{post_id}/like")
async def toggle_like(
    post_id: int, 
    reaction: ReactionRequest = ReactionRequest(reaction_type="like"),
    current_user: User = Depends(get_current_user), 
    db: Session = Depends(get_db)
):
    # Check if post exists
    result = db.execute(select(FeedPost).where(FeedPost.id == post_id))
    post = result.scalar_one_or_none()
    if not post:
        raise HTTPException(status_code=404, detail="Post not found")

    # Check if already liked
    result = db.execute(select(FeedLike).where(
        FeedLike.post_id == post_id,
        FeedLike.user_id == current_user.id
    ))
    existing_like = result.scalar_one_or_none()
    
    liked = False
    current_reaction = None

    if existing_like:
        if existing_like.reaction_type == reaction.reaction_type:
             # Toggle off if same reaction
             await db.delete(existing_like)
             liked = False
        else:
             # Update reaction type
             existing_like.reaction_type = reaction.reaction_type
             liked = True
             current_reaction = reaction.reaction_type
    else:
        # Create new reaction
        new_like = FeedLike(
            post_id=post_id,
            user_id=current_user.id,
            reaction_type=reaction.reaction_type,
            created_at=datetime.utcnow().isoformat()
        )
        db.add(new_like)
        liked = True
        current_reaction = reaction.reaction_type
    
    db.commit()
    return {"liked": liked, "reaction": current_reaction}

@router.post("/{post_id}/comment", response_model=schemas.FeedCommentResponse)
async def add_comment(
    post_id: int, 
    comment_data: schemas.FeedCommentCreate,
    current_user: User = Depends(get_current_user), 
    db: Session = Depends(get_db)
):
    # Check if post exists
    result = db.execute(select(FeedPost).where(FeedPost.id == post_id))
    post = result.scalar_one_or_none()
    if not post:
        raise HTTPException(status_code=404, detail="Post not found")

    new_comment = FeedComment(
        post_id=post_id,
        user_id=current_user.id,
        content=comment_data.content,
        created_at=datetime.utcnow().isoformat()
    )
    db.add(new_comment)
    db.commit()
    db.refresh(new_comment)

    user_name = await get_user_name(current_user, db)
    
    return schemas.FeedCommentResponse(
        id=new_comment.id,
        user_id=new_comment.user_id,
        content=new_comment.content,
        created_at=new_comment.created_at,
        user_name=user_name
    )

# Helper functions
async def get_user_name(user: User, db: Session) -> str:
    if not user: return "Unknown"
    if user.role == UserRole.STUDENT:
        result = db.execute(select(Student).where(Student.user_id == user.id))
        profile = result.scalar_one_or_none()
        return profile.name if profile else "Student"
    elif user.role == UserRole.ORGANIZER:
        result = db.execute(select(Organizer).where(Organizer.user_id == user.id))
        profile = result.scalar_one_or_none()
        return profile.organization_name if profile else "Organizer"
    return "Admin"

async def get_post_response(post: FeedPost, current_user: User, db: Session) -> schemas.FeedPostResponse:
    # Get author details
    result = db.execute(select(User).where(User.id == post.user_id))
    author = result.scalar_one_or_none()
    author_name = await get_user_name(author, db)
    
    # Get main event details
    event_title = None
    if post.event_id:
        result = db.execute(select(Event).where(Event.id == post.event_id))
        event = result.scalar_one_or_none()
        if event:
            event_title = event.title

    # Likes & Reactions
    result = db.execute(select(func.count(FeedLike.id)).where(FeedLike.post_id == post.id))
    likes_count = result.scalar()
    
    # Check current user reaction
    result = db.execute(select(FeedLike).where(
        FeedLike.post_id == post.id,
        FeedLike.user_id == current_user.id
    ))
    user_like = result.scalar_one_or_none()
    is_liked = user_like is not None
    current_user_reaction = user_like.reaction_type if user_like else None
    
    # Get comments
    result = db.execute(select(FeedComment).where(FeedComment.post_id == post.id).order_by(FeedComment.created_at))
    comments = result.scalars().all()
    
    comment_responses = []
    for comment in comments:
        result = db.execute(select(User).where(User.id == comment.user_id))
        comment_author = result.scalar_one_or_none()
        comment_author_name = await get_user_name(comment_author, db)
        
        comment_responses.append(schemas.FeedCommentResponse(
            id=comment.id,
            user_id=comment.user_id,
            content=comment.content,
            created_at=comment.created_at,
            user_name=comment_author_name
        ))

    # Check if following author
    from models import user_follows
    if current_user.id == post.user_id:
        is_following = False # Cannot follow self
    else:
        # Check if current_user follows author
        follow_res = db.execute(select(user_follows).where(
            (user_follows.c.follower_id == current_user.id) & 
            (user_follows.c.followed_id == post.user_id)
        ))
        is_following = follow_res.first() is not None

    return schemas.FeedPostResponse(
        id=post.id,
        user_id=post.user_id,
        content=post.content,
        media_urls=post.media_urls or [],
        media_type=post.media_type,
        event_id=post.event_id,
        location=post.location,
        feeling=post.feeling,
        tagged_users=post.tagged_users or [],
        tagged_events=post.tagged_events or [],
        created_at=post.created_at,
        user_name=author_name,
        user_role=author.role if author else None,
        event_title=event_title,
        likes_count=likes_count,
        comments_count=len(comments),
        is_liked=is_liked,
        current_user_reaction=current_user_reaction,
        is_following=is_following,
        comments=comment_responses
    )
